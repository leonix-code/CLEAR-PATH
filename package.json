{
  "name": "clearpath",
  "version": "1.0.0",
  "private": true,
  "description": "CLEARPATH - Digital Student Clearance and Exam Eligibility Verification System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev:backend": "npm run dev -w apps/backend",
    "build": "npm run build -w packages/shared && npm run build -w apps/backend && npm run build -w apps/frontend",
    "build:frontend": "npm run build -w apps/frontend",
    "build:backend": "npm run build -w apps/backend",
    "test": "npm run test -w apps/backend && npm run test -w apps/frontend",
    "test:backend": "npm run test -w apps/backend",
    "test:frontend": "npm run test -w apps/frontend",
    "test:e2e": "playwright test",
    "lint": "npm run lint -w apps/backend && npm run lint -w apps/frontend",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:migrate": "npm run db:migrate -w apps/backend",
    "db:seed": "npm run db:seed -w apps/backend",
    "db:generate": "npm run db:generate -w apps/backend",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d postgres redis",
    "docker:up:all": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:build": "docker-compose -f docker/docker-compose.yml build",
    "docker:build:proxy": "docker build -t clearpath-caddy -f docker/caddy/Dockerfile .",
    "serve:landing": "npx serve . -l 8080 -n",
    "serve:proxy": "caddy run",
    "clean": "rimraf node_modules apps/*/node_modules packages/*/node_modules apps/*/.next apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
