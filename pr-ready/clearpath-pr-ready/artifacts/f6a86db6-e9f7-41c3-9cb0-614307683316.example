# ---- Core ----
NODE_ENV=production
PORT=4000
API_PREFIX=api
FRONTEND_URL=https://app.clearpath.edu,https://staging.clearpath.edu

# ---- Database ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/clearpath_db?schema=public&connection_limit=20&pool_timeout=20

# ---- Redis (queues, cache, rate-limit store) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ---- Auth (inject from secret manager; NEVER commit real values) ----
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Rate limiting ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---- Mail (nodemailer) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@clearpath.edu

# ---- Storage (cloudinary) ----
CLOUDINARY_URL=
