// --- RefreshToken: store HASH not raw token; add family for reuse detection (C5) ---
// REPLACE the existing model with:
model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique          // was: token (raw). Now sha256(token).
  familyId   String                     // rotation family
  userId     String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  isRevoked  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// --- NEW: real password reset (C2) ---
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("password_resets")
}

// --- NEW: email verification ---
model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("email_verifications")
}

// --- NEW: configurable clearance workflow (H1) ---
model WorkflowDefinition {
  id           String         @id @default(uuid())
  name         String
  courseId     String?
  minLevel     Int?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  steps        WorkflowStep[]
  @@map("workflow_definitions")
}

model WorkflowStep {
  id            String             @id @default(uuid())
  definitionId  String
  requiredRole  UserRole
  departmentId  String?
  order         Int                @default(0)
  mode          String             @default("parallel") // parallel | sequential
  isMandatory   Boolean            @default(true)
  definition    WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  @@index([definitionId])
  @@map("workflow_steps")
}

