generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  ADMINISTRATOR
  REGISTRAR
  FINANCE_OFFICER
  LIBRARY_OFFICER
  LABORATORY_OFFICER
  SPORTS_OFFICER
  DEPARTMENT_OFFICER
  HOSTEL_OFFICER
  LECTURER
  INVIGILATOR
  ICT_SUPPORT
  STUDENT
  PARENT
  SUPERVISOR
}

enum ClearanceStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CONDITIONALLY_APPROVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CONDITIONAL
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ExamEligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
  PENDING_REVIEW
  CONDITIONAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SemesterType {
  FIRST
  SECOND
  SUMMER
}

enum CertificateType {
  CLEARANCE
  GOOD_STANDING
  COMPLETION
  TRANSFER
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  PASSWORD_CHANGE
  EMAIL_VERIFY
  MAGIC_LINK_SENT
  OAUTH_LOGIN
  APPROVE
  REJECT
  GENERATE
  DOWNLOAD
  VERIFY
  EXPORT
  BACKUP
  RESTORE
  PERMISSION_CHANGE
  ROLE_CHANGE
  ACCOUNT_DEACTIVATE
  ACCOUNT_ACTIVATE
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
  GITHUB
  MAGIC_LINK
}

// ==================== MODELS ====================

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  phone             String?
  password          String?
  firstName         String
  lastName          String
  middleName        String?
  gender            Gender?
  dateOfBirth       DateTime?
  address           String?
  avatarUrl         String?
  role              UserRole
  authProvider      AuthProvider @default(LOCAL)
  providerId        String?
  isActive          Boolean      @default(true)
  isVerified        Boolean      @default(false)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  passwordChangedAt DateTime?
  loginCount        Int          @default(0)
  twoFactorEnabled  Boolean      @default(false)
  twoFactorSecret   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  // Relations
  student            Student?
  parentRelation     ParentRelation?
  children           ParentRelation[]  @relation("ParentChildren")
  clearanceApprovals ClearanceApproval[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  sentNotifications  Notification[]    @relation("SentNotifications")
  refreshTokens      RefreshToken[]
  deviceSessions     DeviceSession[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  qrCodes            QRCode[]
  certificates       Certificate[]
  roleAssignments    RoleAssignment[]  @relation("AssignedByUser")

  @@map("users")
}

model RoleAssignment {
  id          String   @id @default(uuid())
  userId      String
  assignedBy  String
  role        UserRole
  reason      String?
  assignedAt  DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User @relation("AssignedByUser", fields: [assignedBy], references: [id])

  @@map("role_assignments")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  group       String   @default("general")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  role         UserRole
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  email     String
  expiresAt DateTime
  verifiedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model DeviceSession {
  id            String   @id @default(uuid())
  userId        String
  deviceName    String?
  deviceType    String?  // mobile, tablet, desktop
  browser       String?
  os            String?
  ipAddress     String?
  userAgent     String?
  refreshToken  String   @unique
  isRemembered  Boolean  @default(false)
  lastActiveAt  DateTime @default(now())
  expiresAt     DateTime
  isRevoked     Boolean  @default(false)
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_sessions")
}

model MagicLink {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("magic_links")
}

model OAuthState {
  id        String   @id @default(uuid())
  state     String   @unique
  provider  AuthProvider
  redirectUrl String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("oauth_states")
}

// ── Existing models below (unchanged) ──

model Student {
  id            String          @id @default(uuid())
  userId        String          @unique
  studentId     String          @unique
  departmentId  String
  courseId      String?
  currentLevel  Int             @default(100)
  yearOfEntry   Int?
  session       String?
  cgpa          Decimal?        @db.Decimal(4, 2)
  totalCredits  Int?            @default(0)
  isEnrolled    Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department          @relation(fields: [departmentId], references: [id])
  course            Course?             @relation(fields: [courseId], references: [id])
  clearanceRequests ClearanceRequest[]
  examEligibilities ExamEligibility[]
  studentHistories  StudentHistory[]

  @@map("students")
}

model ParentRelation {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  relation  String?
  createdAt DateTime @default(now())

  parent  User    @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_relations")
}

model Department {
  id          String          @id @default(uuid())
  name        String          @unique
  code        String          @unique
  description String?
  headId      String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  head                    User?               @relation("DepartmentHead", fields: [headId], references: [id])
  students                Student[]
  courses                 Course[]
  clearanceApprovals      ClearanceApproval[]

  @@map("departments")
}

model Course {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  description  String?
  departmentId String
  duration     Int       @default(4)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  students   Student[]

  @@map("courses")
}

model AcademicYear {
  id        String   @id @default(uuid())
  year      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters Semester[]

  @@map("academic_years")
}

model Semester {
  id              String       @id @default(uuid())
  academicYearId  String
  semesterType    SemesterType
  name            String
  startDate       DateTime
  endDate         DateTime
  registrationDeadline DateTime?
  clearanceDeadline     DateTime?
  isCurrent       Boolean      @default(false)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  clearanceRequests ClearanceRequest[]

  @@unique([academicYearId, semesterType])
  @@map("semesters")
}

model ClearanceRequest {
  id              String          @id @default(uuid())
  studentId       String
  semesterId      String
  status          ClearanceStatus @default(PENDING)
  remarks         String?
  submittedAt     DateTime        @default(now())
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  student            Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester           Semester             @relation(fields: [semesterId], references: [id])
  approvals          ClearanceApproval[]
  examEligibilities  ExamEligibility[]

  @@unique([studentId, semesterId])
  @@map("clearance_requests")
}

model ClearanceApproval {
  id                  String         @id @default(uuid())
  clearanceRequestId  String
  officerId           String
  departmentId        String?
  status              ApprovalStatus @default(PENDING)
  remarks             String?
  approvedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  clearanceRequest ClearanceRequest @relation(fields: [clearanceRequestId], references: [id], onDelete: Cascade)
  officer          User             @relation(fields: [officerId], references: [id])
  department       Department?      @relation(fields: [departmentId], references: [id])

  @@unique([clearanceRequestId, officerId])
  @@map("clearance_approvals")
}

model ExamEligibility {
  id                  String               @id @default(uuid())
  studentId           String
  clearanceRequestId  String?
  semesterId          String
  status              ExamEligibilityStatus @default(PENDING_REVIEW)
  verifiedById        String?
  remarks             String?
  verifiedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clearanceRequest ClearanceRequest? @relation(fields: [clearanceRequestId], references: [id])
  semester         Semester          @relation(fields: [semesterId], references: [id])
  verifiedBy       User?             @relation("ExamVerifier", fields: [verifiedById], references: [id])

  @@unique([studentId, semesterId])
  @@map("exam_eligibilities")
}

model Certificate {
  id              String          @id @default(uuid())
  certificateId   String          @unique
  studentId       String
  issuedById      String
  certificateType CertificateType
  title           String
  description     String?
  metadata        Json?
  fileUrl         String?
  qrCodeUrl       String?
  isVerified      Boolean         @default(false)
  issuedAt        DateTime        @default(now())
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  student  User @relation(fields: [studentId], references: [id])
  issuedBy User @relation(fields: [issuedById], references: [id])

  @@map("certificates")
}

model QRCode {
  id          String   @id @default(uuid())
  code        String   @unique
  userId      String
  data        Json?
  purpose     String
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  scannedAt   DateTime?
  scannedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("qr_codes")
}

model Notification {
  id              String             @id @default(uuid())
  userId          String
  sentById        String?
  title           String
  message         String
  type            NotificationType   @default(IN_APP)
  priority        NotificationPriority @default(NORMAL)
  referenceType   String?
  referenceId     String?
  isRead          Boolean            @default(false)
  readAt          DateTime?
  sentAt          DateTime           @default(now())
  deliveredAt     DateTime?
  createdAt       DateTime           @default(now())

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("SentNotifications", fields: [sentById], references: [id])

  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  deviceSessionId String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entity     String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model StudentHistory {
  id            String   @id @default(uuid())
  studentId     String
  academicYearId String?
  semesterId    String?
  action        String
  description   String?
  performedById String?
  createdAt     DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_histories")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  type      String   @default("string")
  isPublic  Boolean  @default(false)
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model BackupLog {
  id         String   @id @default(uuid())
  fileName   String
  fileSize   Int?
  fileUrl    String?
  status     String
  type       String
  notes      String?
  createdById String?
  createdAt  DateTime @default(now())

  @@map("backup_logs")
}
